# Your Follow Up Boss API Key
# Get it from: FUB Settings > API > Copy your API key
FUB_API_KEY=your_api_key_here

# Safe Mode (recommended for remote deployments) -- disables all delete tools.
# Set to "true" to enable, "false" for full access
FUB_SAFE_MODE=true

# Transport mode:
#   unset or "stdio"  -> Local stdio (Claude Desktop / Cowork default). No auth.
#   "http"            -> Remote HTTP/SSE server (Railway, Fly, etc). Requires MCP_BEARER_TOKEN.
MCP_TRANSPORT=stdio

# Only required when MCP_TRANSPORT=http. Generate a strong random secret (32+ chars).
# Example generators:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Claude's custom connector will send this as: Authorization: Bearer <token>
MCP_BEARER_TOKEN=

# Port for HTTP mode. Railway sets this automatically; leave blank in production.
PORT=3000

# ---------------------------------------------------------------------------
# Autonomous Call Grader (scheduler)
# ---------------------------------------------------------------------------

# Set to "false" to disable the background call grader entirely.
FUB_GRADER_ENABLED=true

# Anthropic API key for AI-powered call grading (Claude Haiku per call, Sonnet for EOD).
# If omitted, falls back to rule-based scoring (duration + outcome heuristics).
ANTHROPIC_API_KEY=

# How often to poll FUB for new calls (seconds). Default: 300 (5 minutes).
GRADER_POLL_INTERVAL_SECONDS=300

# Minimum call duration in seconds to qualify for grading. Default: 120 (2 minutes).
GRADER_MIN_DURATION_SECONDS=120

# Safety cap: max calls graded per poll cycle. Default: 50.
GRADER_MAX_CALLS_PER_RUN=50

# Path to the grader state file (lastRunAt, gradedCallIds, EOD status).
# Note: Railway has an ephemeral filesystem — state resets on restart unless you mount a volume.
GRADER_STATE_FILE=./grader-state.json

# Comma-separated FUB user IDs to @mention on every coaching note (e.g. team lead).
# The agent who placed the call is always mentioned automatically.
GRADER_NOTIFY_USER_IDS=

# --- EOD Summary (sent at 8 pm ET; backup at 9 pm ET) ---

# FUB person ID to post the EOD summary note on (e.g. a shared "Team" contact).
GRADER_EOD_PERSON_ID=

# Comma-separated FUB user IDs to @mention in the EOD note.
GRADER_EOD_NOTIFY_USER_IDS=

# Webhook URL to POST the EOD JSON payload to (Zapier, Make, Slack incoming webhook, etc.).
GRADER_EOD_WEBHOOK_URL=

# Email address for EOD summary delivery (used when Claude calls sendGraderEodSummary manually).
GRADER_EOD_EMAIL=
